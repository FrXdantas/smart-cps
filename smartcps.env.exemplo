# Copie para "smartcps.env" e ajuste. Tudo aqui é OPCIONAL.
# O smartcps.env NUNCA vai para o git (tem senha e chave).

# Porta no seu computador (abrir http://localhost:PORTA)
PORTA=8100

# Admin criado no PRIMEIRO uso (depois disso estas linhas não fazem nada)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# Reparo por LLM na nuvem (precisa de internet). Sem chave, use "Local (Ollama)".
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Ollama no próprio computador (para reparo 100% offline). Padrão já aponta
# para o Ollama do hospedeiro; no Linux o Ollama precisa escutar em 0.0.0.0:
#   sudo systemctl edit ollama  ->  Environment="OLLAMA_HOST=0.0.0.0"
# SMART_JBMC_OLLAMA_URL=http://host.docker.internal:11434/v1

# Memória máxima (MB) para os verificadores. Vazio = 70% da RAM.
# SMART_JBMC_MAX_MEM_TOTAL_MB=8192
