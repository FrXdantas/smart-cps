# Copie este arquivo para .env e ajuste para a sua máquina.
# O .env real NUNCA deve ser versionado (já está no .gitignore).

# --- Ferramentas externas ---
# Prioridade de resolução: este caminho > tools/<nome> (vendorizado) > PATH.
# Deixe em branco para usar tools/ ou o PATH do sistema.
ESBMC_PATH=/caminho/para/esbmc
JBMC_PATH=/caminho/para/jbmc
KOTLINC_PATH=/caminho/para/kotlinc
# JAVAC_PATH, JAVA_PATH, GCC_PATH também são suportados (normalmente vêm do PATH).

# --- Reparo guiado por LLM ---
# A chave é de cada usuário e vai em "Configurar LLM", na tela. Aqui só o modelo padrão.
DEEPSEEK_MODEL=deepseek-v4-flash
